---
// Bag drawer (docs/08 §4) + handoff dialog (docs/09 rule 1). Behaviour in src/lib/bag.js.
import Pending from './Pending.astro';
import { ticketmelon } from '../data/event.js';
---
<div class="scrim" data-bag-scrim hidden></div>
<aside class="bag" data-bag role="dialog" aria-modal="true" aria-labelledby="bag-title" hidden>
  <div class="bag-head">
    <h2 id="bag-title" class="display">Your bag</h2>
    <button type="button" class="icon-btn" data-bag-close aria-label="Close bag">✕</button>
  </div>

  <div class="bag-body">
    <ul class="lines" data-bag-lines></ul>
    <div class="empty" data-bag-empty>
      <p>Your bag is empty.</p>
      <a class="btn btn-ghost btn-sm" href="/tickets">Browse tickets</a>
    </div>
  </div>

  <div class="bag-foot" data-bag-foot>
    <details class="promo">
      <summary>Have a promo code?</summary>
      <label class="field">
        <span class="sr-only">Promo code</span>
        <input class="input" type="text" data-bag-promo autocomplete="off" autocapitalize="characters" placeholder="Enter code" />
      </label>
      <p class="small muted">Applied on Ticketmelon at checkout. <Pending tm ref="T3" /></p>
    </details>
    <div class="subtotal">
      <span>Subtotal</span>
      <strong class="num" data-bag-subtotal>₱0</strong>
    </div>
    <p class="small muted">Service and payment fees are added at checkout.</p>
    <button type="button" class="btn btn-block" data-bag-checkout disabled>Checkout</button>
    <p class="redirect small muted">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 11V8a6 6 0 0 1 12 0v3M5 11h14v10H5z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
      Secure payment on <strong>ticketmelon.com</strong>
    </p>
    <ul class="pay small muted" aria-label="Payment methods">
      {ticketmelon.paymentMethods.map((m) => <li>{m}</li>)}
    </ul>
  </div>
</aside>

<div class="scrim" data-handoff-scrim hidden></div>
<div class="handoff" data-handoff role="alertdialog" aria-modal="true" aria-labelledby="handoff-title" aria-describedby="handoff-desc" hidden>
  <svg class="handoff-mark" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="22" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 24h16m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <h2 id="handoff-title">Heading to Ticketmelon</h2>
  <p id="handoff-desc" class="muted" data-handoff-desc>Your tickets are already in the cart there. Log in or sign up on Ticketmelon to pay.</p>
  <div class="pending-box" data-handoff-pending hidden>
    <Pending tm ref="T3 · Q2" />
    <p class="small">Checkout isn’t connected yet. Once we have the client’s Ticketmelon event and ticket IDs, this button sends the bag to Ticketmelon with these tickets pre-selected.</p>
  </div>
  <details class="debug ph-only" data-handoff-debug>
    <summary>Handoff URL</summary>
    <code data-handoff-url></code>
  </details>
  <div class="handoff-actions">
    <button type="button" class="btn btn-ghost" data-handoff-cancel>Back</button>
    <a class="btn" data-handoff-go href="#">Continue to Ticketmelon</a>
  </div>
</div>

<style>
  .scrim { position: fixed; inset: 0; z-index: 80; background: rgb(0 0 0 / 0.65); }
  .scrim[hidden], .bag[hidden], .handoff[hidden], .pending-box[hidden], .bag-foot[hidden] { display: none; }

  .bag {
    position: fixed; z-index: 90; top: 0; right: 0; bottom: 0;
    width: min(440px, 100%); display: flex; flex-direction: column;
    background: var(--surface); border-left: 1px solid var(--line);
    animation: slide-in 0.22s ease-out;
  }
  @keyframes slide-in { from { transform: translateX(24px); opacity: 0; } }
  .bag-head { display: flex; justify-content: space-between; align-items: center; padding: 20px 20px 16px; border-bottom: 1px solid var(--line); }
  .bag-head h2 { font-size: 26px; }
  .icon-btn { width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 50%; background: transparent; cursor: pointer; }
  .bag-body { flex: 1; overflow-y: auto; padding: 16px 20px; }
  .lines { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .empty { display: grid; gap: 16px; justify-items: start; color: var(--muted); padding: 12px 0; }
  .empty[hidden] { display: none; }
  .bag-foot { display: grid; gap: 12px; padding: 16px 20px 20px; border-top: 1px solid var(--line); background: var(--surface); }
  .promo summary { cursor: pointer; font-weight: 600; font-size: 15px; min-height: 32px; display: flex; align-items: center; }
  .promo[open] { display: grid; gap: 8px; }
  .promo .input { text-transform: uppercase; }
  .subtotal { display: flex; justify-content: space-between; align-items: baseline; font-size: 18px; }
  .subtotal strong { font-size: 24px; }
  .redirect { display: flex; gap: 6px; align-items: center; justify-content: center; }
  .redirect svg { width: 16px; height: 16px; }
  .pay { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }
  .pay li { padding: 2px 8px; border: 1px solid var(--line); border-radius: 4px; font-size: 12px; }

  @media (max-width: 560px) {
    .bag { top: auto; max-height: 92dvh; border-left: 0; border-top: 1px solid var(--line); border-radius: 16px 16px 0 0; animation-name: sheet-up; }
    @keyframes sheet-up { from { transform: translateY(40px); opacity: 0; } }
  }

  .handoff {
    position: fixed; z-index: 100; left: 50%; top: 50%; translate: -50% -50%;
    width: min(480px, calc(100% - 32px)); padding: 28px; display: grid; gap: 14px;
    border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--line);
  }
  .handoff-mark { width: 44px; height: 44px; color: var(--metal-mid); }
  .handoff h2 { font-size: 24px; }
  .pending-box { display: grid; gap: 8px; padding: 14px; border: 1px dashed var(--accent); border-radius: var(--radius); }
  .pending-box :global(.ph-tag) { justify-self: start; }
  .debug { font-size: 13px; color: var(--muted); }
  .debug summary { cursor: pointer; }
  .debug code { display: block; margin-top: 8px; padding: 10px; border-radius: 6px; background: var(--bg); word-break: break-all; color: var(--text); font-size: 12px; max-height: 140px; overflow: auto; }
  .handoff-actions { display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; margin-top: 6px; }
  .handoff-actions [hidden] { display: none; }
</style>

<style is:global>
  .bag-line {
    display: grid; grid-template-columns: 1fr auto; gap: 10px 12px; align-items: center;
    padding: 14px; border-radius: var(--radius); background: var(--surface-2); border: 1px solid var(--line);
  }
  .bag-line .line-name { font-weight: 700; }
  .bag-line .line-meta { font-size: 13px; color: var(--muted); }
  .bag-line .line-total { font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; }
  .bag-line .line-qty { display: inline-grid; grid-template-columns: 36px 32px 36px; align-items: center; border: 1px solid var(--line); border-radius: 999px; }
  .bag-line .line-qty button { height: 36px; border: 0; background: transparent; cursor: pointer; font-size: 18px; }
  .bag-line .line-qty button:disabled { color: var(--line); cursor: not-allowed; }
  .bag-line .line-qty output { text-align: center; font-weight: 700; font-variant-numeric: tabular-nums; }
  .bag-line .line-remove { justify-self: end; border: 0; background: none; color: var(--muted); text-decoration: underline; cursor: pointer; font-size: 13px; min-height: 36px; }
</style>
