---
// Homepage lineup slot while the lineup is embargoed (edition.lineupRevealAt).
// A chrome curtain hangs over the lineup area. Visitors can push, tug and drag it, but it is pinned to the rod
// and always falls shut: src/lib/curtain.js.
//
// Behind it: a heavily blurred lineup, glimpsed when the curtain swings or is pulled aside. It has the real
// lineup's layout and act counts per billing tier, but the letters are scrambled consonant strings, never names:
// anything in this HTML is public (view-source), and under this much blur real and scrambled text look the same.
// So it reads as "the lineup is right there" whether the client has filled it in yet or not (ADR 0004).
import Pending from './Pending.astro';
import { edition, artists, lineupRevealLabel } from '../data/event.js';

const [revealDay, revealTime] = lineupRevealLabel.split(' · ');
const count = (b) => artists.filter((a) => a.billing === b).length;

// Scrambled stand-ins: seeded (stable between builds), unpronounceable so nobody mistakes them for a leak.
// Word lengths come from the seed, not from real names, so they say nothing about who is playing.
let seed = 20270123;
const rand = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const pick = (a, b) => a + Math.floor(rand() * (b - a + 1));
const CONS = 'BCDFGHJKLMNPRSTVWXZ';
const word = (min, max) => Array.from({ length: pick(min, max) }, () => CONS[Math.floor(rand() * CONS.length)]).join('');
const act = (words, min, max) => Array.from({ length: words() }, () => word(min, max)).join(' ');
const title = (s) => s.charAt(0) + s.slice(1).toLowerCase().replace(/ (\w)/g, (_, c) => ` ${c.toUpperCase()}`);
const teaser = {
  head: Array.from({ length: Math.max(count('headliner'), 2) }, () => act(() => pick(1, 2), 4, 8)),
  sub: Array.from({ length: Math.max(count('sub'), 3) }, () => act(() => pick(1, 3), 3, 7)),
  support: Array.from({ length: Math.max(count('support'), 6) }, () => title(act(() => pick(1, 2), 3, 8))),
};
---
<div class="curtain-stage" data-curtain data-reveal-at={edition.lineupRevealAt}>
  <div class="backstage" aria-hidden="true" inert>
    <ul class="t-head">{teaser.head.map((n) => <li class="display metal">{n}</li>)}</ul>
    <ul class="t-sub">{teaser.sub.map((n) => <li>{n}</li>)}</ul>
    <ul class="t-support">{teaser.support.map((n) => <li>{n}</li>)}</ul>
    <p class="t-more">+ more to be announced</p>
  </div>

  <canvas class="cloth" aria-hidden="true"></canvas>
  <canvas class="rod" aria-hidden="true"></canvas>

  <div class="plate" data-curtain-plate>
    <p class="eyebrow">Lineup reveal <Pending ref="Q5 copy" /></p>
    <p class="when display metal" aria-label={lineupRevealLabel}>{revealDay}{revealTime && <span class="time">{revealTime}</span>}</p>
    <p class="small muted num" data-curtain-countdown></p>
    <a class="btn btn-sm" href="#waitlist">Tell me first</a>
  </div>
  <p class="say small" data-curtain-say aria-live="polite"></p>
</div>

<style>
  .curtain-stage {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: clamp(440px, 62vh, 620px);
    border: 1px solid var(--line); border-radius: var(--radius-lg);
    background: radial-gradient(80% 60% at 50% 100%, var(--surface-2), var(--bg));
    touch-action: pan-y; /* vertical swipes still scroll the page on phones */
    user-select: none; -webkit-user-select: none;
    cursor: grab;
  }
  .curtain-stage.grabbing { cursor: grabbing; }

  /* Blurred lineup behind the curtain. Same type scale as the revealed lineup (pages/index.astro .lu-*), lit
     dimly from above like a stage behind closed drapes. Scrambled letters only, see frontmatter. */
  .backstage {
    position: absolute; inset: 0; overflow: hidden;
    display: flex; flex-direction: column; justify-content: flex-end; /* sits low, where the hem lifts and parts */
    padding: 70px clamp(16px, 4vw, 40px) 56px;
    pointer-events: none; user-select: none; -webkit-user-select: none;
    text-align: center; /* poster-style, so whichever edge of the curtain lifts, there is lineup behind it */
    -webkit-mask-image: linear-gradient(#000 75%, transparent);
    mask-image: linear-gradient(#000 75%, transparent);
    transform: translateZ(0); /* own layer: blurred once, not on every curtain frame */
  }
  .backstage ul { list-style: none; margin: 0; padding: 0; }
  .t-head li {
    font-size: calc(clamp(40px, 9vw, 112px) * var(--display-fit));
    white-space: nowrap; filter: blur(clamp(9px, 1.4vw, 16px));
  }
  .t-head li + li { margin-top: 4px; }
  .t-sub, .t-support { display: flex; flex-wrap: wrap; justify-content: center; filter: blur(7px); }
  .t-sub { gap: 4px 28px; margin-top: 28px; }
  .t-sub li {
    font-size: clamp(22px, 3.4vw, 38px); font-weight: 700; font-family: var(--font-display);
    text-transform: uppercase; letter-spacing: var(--display-tracking); color: var(--text);
  }
  .t-support { gap: 4px 22px; margin-top: 18px; filter: blur(5px); }
  .t-support li { font-size: clamp(17px, 2vw, 22px); font-weight: 600; color: var(--text); }
  .t-more { margin: 20px 0 0; font-size: 14px; color: var(--muted); filter: blur(3px); }

  /* No-JS / pre-paint fallback: static pleats. The script hides this once the canvas draws. */
  .cloth {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block;
    background:
      linear-gradient(var(--metal-mid), var(--metal-lo)) top / 100% 24px no-repeat,
      linear-gradient(to bottom, rgb(0 0 0 / 0.45), transparent 60px) 0 24px / 100% 100% no-repeat,
      repeating-linear-gradient(90deg, var(--metal-lo) 0 4%, var(--metal-mid) 7%, var(--metal-hi) 9%, var(--metal-mid) 11%, var(--metal-lo) 15%);
  }
  .cloth.live { background: none; }
  .rod { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; }

  /* The sign. curtain.js hangs it on a chain (sets --plate-top and a swing transform); without JS it sits on
     two dotted "chains" up to the rod. */
  .plate {
    position: absolute; z-index: 2; left: 50%; top: 56px;
    width: min(360px, calc(100% - 32px)); translate: -50% 0; transform-origin: 50% 0;
    display: grid; justify-items: center; gap: 8px; padding: 22px 20px 20px; text-align: center;
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.07), transparent 40%),
      color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    border: 1px solid var(--metal-mid); border-radius: var(--radius-lg);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.18), inset 0 0 0 3px color-mix(in srgb, var(--metal-lo) 60%, transparent),
      0 22px 38px -6px rgb(0 0 0 / 0.6), 0 6px 12px rgb(0 0 0 / 0.35);
    pointer-events: none; /* without JS, drags pass through to the curtain... */
    will-change: transform;
  }
  .curtain-stage.live .plate { top: var(--plate-top, 56px); pointer-events: auto; cursor: grab; }
  .curtain-stage.grabbing .plate { cursor: grabbing; }
  .plate a { pointer-events: auto; margin-top: 6px; cursor: pointer; } /* ...but the button always works */
  .plate::before, .plate::after {
    content: ''; position: absolute; top: -34px; height: 34px; width: 0;
    border-left: 2px dotted var(--metal-mid);
  }
  .plate::before { left: 22%; }
  .plate::after { right: 22%; }
  .curtain-stage.live .plate::before, .curtain-stage.live .plate::after { content: none; }
  .when { font-size: calc(clamp(28px, 4.6vw, 44px) * var(--display-fit)); line-height: 1.05; }
  .when .time { display: block; font-size: 0.55em; margin-top: 4px; }
  .plate :global(.ph-tag) { pointer-events: auto; }

  .say {
    position: absolute; z-index: 2; left: 50%; bottom: 22px; translate: -50% 0; margin: 0;
    padding: 8px 14px; border-radius: var(--pill); white-space: nowrap; max-width: calc(100% - 32px);
    overflow: hidden; text-overflow: ellipsis;
    background: var(--bg); color: var(--text); border: 1px solid var(--line);
    opacity: 0; transition: opacity 0.25s; pointer-events: none;
  }
  .say.show { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .say { transition: none; }
  }
</style>

<script>
  import { initCurtain } from '../lib/curtain.js';
  document.querySelectorAll('[data-curtain]').forEach((el) => initCurtain(el));
</script>
