---
import Logo from './Logo.astro';
import { nav, edition, saleStates } from '../data/event.js';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const sale = saleStates[edition.saleState];
---
<a class="skip" href="#main">Skip to content</a>
<header class="header" data-header>
  <div class="wrap header-inner">
    <Logo />
    <nav class="nav" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="actions">
      <span class="date small muted num">{edition.dateLabel}</span>
      <button class="bag-btn" type="button" data-bag-open aria-label="Open bag">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1.2 12H6.2L5 8Z M9 8V6a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        <span class="bag-count num" data-bag-count hidden>0</span>
      </button>
      <a class="btn btn-sm pill" href={sale.ctaHref} data-sale-text="cta" data-sale-href>{sale.cta}</a>
      <button class="menu-btn" type="button" data-menu-open aria-label="Open menu" aria-expanded="false" aria-controls="menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" data-menu hidden>
  <div class="wrap menu-top">
    <Logo />
    <button class="menu-close" type="button" data-menu-close aria-label="Close menu">✕</button>
  </div>
  <nav class="wrap menu-nav" aria-label="Mobile">
    <a href="/" class="display">Home</a>
    {nav.map((item) => <a href={item.href} class="display">{item.label}</a>)}
  </nav>
  <div class="wrap menu-foot">
    <p class="eyebrow">{edition.dateLong}</p>
    <p class="muted">{edition.venue.name}, {edition.venue.city}</p>
  </div>
</div>

<style>
  .header {
    position: sticky; top: 0; z-index: 30;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner { display: flex; align-items: center; gap: 24px; height: 68px; }
  .nav { display: flex; gap: 4px; margin-left: 12px; }
  .nav a {
    padding: 10px 12px; border-radius: var(--pill);
    text-decoration: none; color: var(--muted); font-weight: 500;
  }
  .nav a:hover { color: var(--text); }
  .nav a[aria-current='page'] { color: var(--text); background: var(--surface-2); }
  .actions { margin-left: auto; display: flex; align-items: center; gap: 10px; }
  .date { margin-right: 6px; }
  .bag-btn {
    position: relative; width: 44px; height: 44px; display: grid; place-items: center;
    border: 1px solid var(--line); border-radius: 50%; background: transparent; cursor: pointer;
  }
  .bag-btn svg { width: 22px; height: 22px; }
  .bag-count {
    position: absolute; top: -4px; right: -4px; min-width: 20px; height: 20px; padding: 0 5px;
    display: grid; place-items: center; border-radius: 999px;
    background: var(--cta); color: var(--cta-ink); font-size: 12px; font-weight: 700;
  }
  .bag-count[hidden] { display: none; }
  .menu-btn {
    display: none; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 50%;
    background: transparent; cursor: pointer; place-content: center; gap: 5px;
  }
  .menu-btn span { display: block; width: 18px; height: 2px; background: currentColor; }
  [data-theme='c'] .bag-btn, [data-theme='c'] .menu-btn { border-radius: 0; }

  @media (max-width: 1020px) { .date { display: none; } }
  @media (max-width: 860px) {
    .nav { display: none; }
    .menu-btn { display: grid; }
  }
  .pill { white-space: nowrap; }
  @media (max-width: 480px) {
    .header-inner { gap: 8px; }
    .actions { gap: 6px; }
    .pill { padding: 0 14px; font-size: 14px; }
    .bag-btn, .menu-btn { width: 42px; height: 42px; }
    .header :global(.logo .brand) { display: none; }
    .header :global(.logo .title) { font-size: 15px; }
    .header :global(.logo .mark) { width: 28px; height: 28px; }
  }

  .menu {
    position: fixed; inset: 0; z-index: 70; overflow-y: auto;
    background: var(--texture), var(--bg);
    display: flex; flex-direction: column;
  }
  .menu[hidden] { display: none; }
  .menu-top { display: flex; justify-content: space-between; align-items: center; height: 68px; }
  .menu-close {
    width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 50%; background: transparent; cursor: pointer;
  }
  .menu-nav { display: grid; gap: 4px; padding: 32px 0; }
  .menu-nav a { font-size: clamp(40px, 12vw, 64px); text-decoration: none; padding: 4px 0; }
  .menu-nav a:hover { color: var(--metal-mid); }
  .menu-foot { margin-top: auto; padding: 24px 0 40px; border-top: 1px solid var(--line); display: grid; gap: 4px; }
</style>
